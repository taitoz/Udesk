{
  "asar": true,
  "directories": {
    "output": "release-builds/"
  },
  "files": [
    "!*",
    "!**/*",
    "main.js",
    "assets/**/*",
    "dist/**/*",
    "node_modules/**/*",
    "!node_modules/primeng/resources/themes/**/*",
    "!node_modules/react*/**/*"
  ],
  "win": {
    "icon": "assets/ico/logo.ico",
    "target": [
      "portable",
      "squirrel"
    ]
  },
  "portable": {
    "unpackDirName": "udesk",
    "splashImage": "assets/png/logo.png"
  },
  "mac": {
    "icon": "assets/mac/32.icns",
    "target": [
      "dmg"
    ]
  },
  "linux": {
    "icon": "assets/png/logo.png",
    "target": [
      "AppImage"
    ]
  },
  "electronLanguages": [
    "ru"
  ]
}
