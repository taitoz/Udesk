{
    "name": "Uchet-Electron-App",
    "productName": "Uchet.kz Desktop",
    "description": "Uchet.kz Desktop Application",
    "version": "0.1.0",
    "main": "main.js",
    "devDependencies": {
        "asar": "^3.2.0",
        "electron": "^27.1.2",
        "electron-installer-dmg": "^4.0.0",
        "electron-packager": "^17.1.2",
        "electron-squirrel-startup": "^1.0.0",
        "electron-winstaller": "^5.2.1"
    },
    "scripts": {
        "start": "electron .",
        "package-win": "electron-packager . uchet-desktop --overwrite --asar --platform=win32 --arch=ia32 --icon=assets/icons/48.ico --prune=true --out=release-builds --version-string.CompanyName=CE --version-string.FileDescription=CE --version-string.ProductName=\"Uchet.kz Desktop\"",
        "package-linux": "electron-packager . uchet-desktop --overwrite --asar --platform=linux --arch=x64 --icon=assets/icons/png/48.png --prune=true --out=release-builds",
        "package-mac": "electron-packager . uchet-desktop --overwrite --platform=darwin --arch=x64 --icon=assets/icons/mac/32.icns --prune=true --out=release-builds",
        "create-installer-mac": "node installers/mac/createinstaller.js",
        "create-installer-win": "node installers/windows/createinstaller.js"
    },
    "build": {
        "electronLanguages": [
            "ru_RU"
        ],
        "afterSign": "./after-sign.js",
        "afterPack": "./internals/scripts/AfterPack.js"
    },
    "dependencies": {
        "custom-electron-titlebar": "^4.2.8",
        "electron-preferences": "^2.8.2"
    }
}
