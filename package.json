{
  "name": "UDesk",
  "productName": "UDesk",
  "version": "2.0.0-alpha",
  "description": "universal access to multiple local and web interfaces with automation capabilities in a single unified UI",
  "author": {
    "name": "Konstantin Pak",
    "email": "konstantin13@gmail.com",
    "url": "https://github.com/taitoz/"
  },
  "main": "main.js",
  "type": "module",
  "engines": {
    "node": "^20.11.1 || >=22.0.0",
    "npm": ">=10.0.0"
  },
  "private": true,
  "scripts": {
    "pack": "electron-builder --dir",
    "dist": "electron-builder -- --publish never",
    "dist-win": "GENERATE_SOURCEMAP=false electron-builder -w",
    "ng": "ng",
    "start": "npm-run-all -p electron:serve ng:serve",
    "ng:serve": "ng serve -c web -o",
    "build": "npm run electron:serve-tsc && ng build --base-href ./",
    "build:dev": "npm run build -- -c dev",
    "build:prod": "npm run build -- -c production",
    "web:build": "npm run build -- -c web-production",
    "electron": "electron",
    "electron:serve-tsc": "tsc -p tsconfig.serve.json",
    "electron:serve": "wait-on tcp:4200 && npm run electron:serve-tsc && electron . --serve",
    "electron:local": "npm run build:prod && electron .",
    "electron:build": "npm run build:prod && electron-builder build --publish=never",
    "version": "conventional-changelog -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "boxicons": "^2.1.4",
    "electron-cfg": "^1.2.7",
    "electron-log": "^5.2.2",
    "electron-simple-updater": "^2.0.11",
    "nestdb": "^2.0.0",
    "primeflex": "^4.0.0",
    "primeng": "^21.1.1",
    "puppeteer-core": "^23.11.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-in-electron": "^3.0.5"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^21.0.3",
    "@angular-devkit/build-angular": "^21.0.7",
    "@angular-devkit/core": "^21.0.7",
    "@angular-devkit/schematics": "^21.0.7",
    "@angular/animations": "^21.0.7",
    "@angular/cli": "^21.0.7",
    "@angular/common": "^21.0.7",
    "@angular/compiler": "^21.0.7",
    "@angular/compiler-cli": "^21.0.7",
    "@angular/core": "^21.0.7",
    "@angular/forms": "^21.0.7",
    "@angular/language-service": "^21.0.7",
    "@angular/platform-browser": "^21.0.7",
    "@angular/platform-browser-dynamic": "^21.0.7",
    "@angular/router": "^21.0.7",
    "@electron/asar": "^3.2.0",
    "@ngx-translate/core": "15.0.0",
    "@ngx-translate/http-loader": "8.0.0",
    "@types/node": "^22.10.2",
    "angular-web-storage": "^21.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^25.1.8",
    "electron-builder-squirrel-windows": "^25.1.8",
    "electron-debug": "4.0.1",
    "electron-reloader": "1.2.3",
    "electron-squirrel-startup": "^1.0.1",
    "ngx-electronyzer": "^21.0.0",
    "node-polyfill-webpack-plugin": "4.0.0",
    "npm-run-all": "4.1.5",
    "path-browserify": "^1.0.1",
    "rxjs": "7.8.1",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "typescript": "~5.9.0",
    "wait-on": "^9.0.4",
    "webpack": "^5.97.1",
    "zone.js": "0.15.0"
  }
}
