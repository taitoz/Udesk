{
    "name": "Uchet-Electron-App",
    "productName": "Uchet.kz Desktop",
    "version": "0.1.0",
    "main": "main.js",
    "devDependencies": {
        "electron": "^27.1.2",
        "electron-packager": "^17.1.2",
        "electron-winstaller": "^5.2.1"
    },
    "scripts": {
        "package-win": "electron-packager . uchet-desktop --overwrite --asar=true --platform=win32 --arch=ia32 --icon=assets/icons/icon.ico --prune=true --out=release-builds --version-string.CompanyName=CE --version-string.FileDescription=CE --version-string.ProductName=\"Uchet.kz Desktop\"",    
        "package-linux": "electron-packager . uchet-desktop --overwrite --asar=true --platform=linux --arch=x64 --icon=assets/icons/png/1024x1024.png --prune=true --out=release-builds",
        "package-mac": "electron-packager . uchet-desktop --overwrite --platform=darwin --arch=x64 --icon=assets/icons/mac/icon.icns --prune=true --out=release-builds"
    }
}
