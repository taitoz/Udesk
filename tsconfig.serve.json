{
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "outDir": "./out-tsc",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "module": "ES2015",
    "target": "es2015",
    "types": [
      "node",
      "electron"
    ],
    "lib": [
      "es2017",
      "es2016",
      "es2015",
      "dom"
    ]
  },
  "files": [
    "src/main.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}